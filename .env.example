# FactorFlow local configuration example. Copy to .env and fill in.
# The application refuses to start in non-development mode with default values.

FF_ENV=development
FF_HTTP_ADDR=:8080
FF_LOG_LEVEL=debug

# The built interface this process serves. Empty means the process is an API and nothing
# else; the container image sets it to /app/web.
FF_WEB_DIR=

# Admitting a participant is a decision somebody takes, so it is off outside development.
# A public demo is the honest exception: a judge who registers at midnight has nobody to
# admit them.
FF_AUTO_APPROVE=

# PostgreSQL
FF_DATABASE_URL=postgres://factorflow:factorflow@localhost:5432/factorflow?sslmode=disable

# External providers. Empty value selects the in-process fake adapter.
# Hedera. With both set, every approved receivable is minted as a real fungible token whose
# supply is its face value in minor units. Without them nothing reaches a network and the
# in-process issuer reports its network as "local", which nothing can mistake for a testnet.
FF_HEDERA_ACCOUNT_ID=
FF_HEDERA_PRIVATE_KEY=
FF_HEDERA_NETWORK=testnet
# The Graph. With a key, the benchmark is the liquidity-weighted median supply yield across
# the configured subgraphs; without one it comes from the deterministic demo market set, and
# the snapshot says which by naming its provider.
FF_GRAPH_API_KEY=
FF_GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api/subgraphs/id
FF_GRAPH_NETWORK=ethereum
FF_GRAPH_ASSET=USDC
FF_CRE_ENDPOINT=
FF_LLM_API_KEY=
FF_LLM_BASE_URL=
FF_LLM_MODEL=

# What a machine customer pays for one answer, and where. On a chain the price is in the
# network's own unit — quoting it in dollars would mean inventing an exchange rate. Without
# a Hedera recipient the in-process facilitator runs the same exchange offline.
FF_PAID_PRICE=0.25
FF_PAID_CURRENCY=HBAR
FF_PAID_ASSET=HBAR
FF_PAID_NETWORK=testnet
FF_PAID_RECIPIENT=

# The demo's paying agent: a second account, because a payment has to come from somebody
# other than the account it pays. Used only by "factorflow agent".
FF_AGENT_ACCOUNT_ID=
FF_AGENT_PRIVATE_KEY=

# Deployment only, read by deploy/docker-compose.prod.yml rather than by the application.
# DOMAIN is the name Caddy gets a certificate for; POSTGRES_PASSWORD is the database's own.
DOMAIN=
POSTGRES_PASSWORD=
