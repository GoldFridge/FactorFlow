# Caddy terminates TLS and gets its own certificate from Let's Encrypt for {$DOMAIN}.
#
# HTTPS is not decoration here: the session cookie is marked Secure outside development, so
# over plain HTTP the browser would drop it and nobody could stay signed in. A wallet
# signature is also refused by some extensions on an insecure origin.
{$DOMAIN} {
	encode gzip

	# The application is one process: it serves both the API and the interface, so there is
	# nothing to route between.
	reverse_proxy app:8080 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}

# The other name people type — usually the apex when {$DOMAIN} is www, or www when it is the
# apex. It redirects rather than serving a second copy: a session cookie belongs to one host,
# so somebody who signed in at one name would find themselves signed out by following a link
# to the other.
#
# The default is deliberately an http:// address that resolves to nothing. Caddy asks for a
# certificate for every https site it is given, and a name whose DNS does not point here
# cannot pass the challenge — so an alias nobody has configured must not be one Caddy tries
# to secure. Set DOMAIN_ALIAS once the second name's A record exists, and not before.
{$DOMAIN_ALIAS:http://alias.invalid} {
	redir https://{$DOMAIN}{uri} permanent
}
